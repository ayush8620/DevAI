# Database: Neon PostgreSQL (free tier) or any PostgreSQL.
# For docker-compose: postgresql://devai:devai_local_password@localhost:5432/devai
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash — TCP connection for ioredis)
# For docker-compose: redis://:devai_redis_password@localhost:6379
REDIS_URL=rediss://default:token@host:6379

# Encryption key for provider API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_ENCRYPTION_KEY=

# Admin API key for dashboard access (generate with: node -e "console.log('dvai_admin_' + require('crypto').randomBytes(24).toString('hex'))")
ADMIN_API_KEY=

# Gateway server
GATEWAY_PORT=3001
NODE_ENV=development

# Browser origins allowed by CORS, comma-separated (e.g. https://your-dashboard.vercel.app), or *.
# localhost is allowed automatically only when NODE_ENV is not production.
ALLOWED_ORIGINS=

# --- Clerk sign-in for the admin API (optional) ---
# With these set, the dashboard's Clerk session token is accepted on /admin/* in addition
# to ADMIN_API_KEY. Only allowlisted users get in; with no allowlist, Clerk tokens are refused.
# Secret key from Clerk dashboard -> API keys (sk_test_... / sk_live_...). Used to fetch the
# signing keys (JWKS) and to look up user emails for ADMIN_EMAILS.
# CLERK_SECRET_KEY=
# Optional: the PEM public key from Clerk dashboard -> API keys -> "JWKS Public Key" for
# networkless verification (newlines may be written as \n). CLERK_SECRET_KEY is still
# needed for ADMIN_EMAILS lookups unless you use ADMIN_USER_IDS.
# CLERK_JWT_KEY=
# Comma-separated allowlist (verified emails and/or Clerk user ids like user_2abc...).
# ADMIN_EMAILS=you@example.com
# ADMIN_USER_IDS=
# Session tokens must come from one of ALLOWED_ORIGINS (checked against the token's azp claim).

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional, LOCAL DEV ONLY: pre-fills the dashboard admin key. It is embedded in the
# browser bundle, so never set it on a public deployment (enter the key in Settings instead).
# NEXT_PUBLIC_ADMIN_API_KEY=
DASHBOARD_PORT=3000
# Dashboard Clerk and Razorpay keys go in packages/dashboard/.env.local (see packages/dashboard/.env.example).
