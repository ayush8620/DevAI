# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash — TCP connection for ioredis)
REDIS_URL=rediss://default:token@host:6379

# Encryption key for provider API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_ENCRYPTION_KEY=

# Admin API key for dashboard access (generate with: node -e "console.log('dvai_admin_' + require('crypto').randomBytes(24).toString('hex'))")
ADMIN_API_KEY=

# Gateway server
GATEWAY_PORT=3001
NODE_ENV=development

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001
DASHBOARD_PORT=3000
