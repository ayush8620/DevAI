# Copy to packages/dashboard/.env.local (Next.js reads env files from this folder).

# Gateway URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: public site URL for absolute Open Graph image links (defaults to https://devai-dashboard-six.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# --- Clerk sign-in (optional) ---
# Without NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY the dashboard works as before: /dashboard is open
# and you paste the gateway ADMIN_API_KEY on the Settings page. The build works either way.
# With both keys set, /dashboard requires sign-in (email, Google, GitHub: whatever is enabled
# in the Clerk dashboard) and API calls use the Clerk session instead of the admin key.
# Keys: Clerk dashboard -> Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional, LOCAL DEV ONLY: pre-fills the admin key. It is embedded in the browser bundle,
# so never set it on a public deployment.
# NEXT_PUBLIC_ADMIN_API_KEY=

# --- Razorpay subscriptions for /pricing and /dashboard/billing (optional) ---
# Without RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET (and the Clerk keys above), upgrade buttons show
# "Payments coming soon" and every account stays on Free. Keys: Razorpay Dashboard ->
# Account & Settings -> API keys (use rzp_test_... keys while testing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID; read by Checkout.js in the browser (key ids are public).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay plan ids (create them with: node scripts/razorpay-create-plans.mjs). A plan/period
# without an id shows "Payments coming soon". Yearly ids are optional.
RAZORPAY_PLAN_ID_STUDENT=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_TEAM=
RAZORPAY_PLAN_ID_STUDENT_YEARLY=
RAZORPAY_PLAN_ID_PRO_YEARLY=
RAZORPAY_PLAN_ID_TEAM_YEARLY=
# Secret you choose when adding the webhook (Razorpay Dashboard -> Webhooks):
#   URL https://<your-dashboard>/api/billing/webhook, events: subscription.authenticated,
#   subscription.activated, subscription.charged, subscription.pending, subscription.halted,
#   subscription.cancelled, subscription.completed, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Optional, server only: the gateway ADMIN_API_KEY, so the webhook can confirm promo-code
# redemptions when the browser was closed right after paying. Never prefix with NEXT_PUBLIC_.
# GATEWAY_ADMIN_API_KEY=
# Optional: gateway URL for server-side calls (defaults to NEXT_PUBLIC_API_URL).
# GATEWAY_URL=
